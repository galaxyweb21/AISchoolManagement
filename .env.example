# Local development example
SECRET_KEY=django-insecure-local-development-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# MySQL development database
# In local DEBUG mode, this database is preferred even if DATABASE_URL exists
# in the Windows/system environment.
LOCAL_DEV_USE_MYSQL=True
DB_NAME=ai_school_management
DB_USER=Raja
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Optional PostgreSQL / Render deployment. Used when DEBUG=False or when
# LOCAL_DEV_USE_MYSQL=False.
# DATABASE_URL=postgresql://user:password@host:5432/database

GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_COMMENT_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=60

# Email: use Gmail SMTP locally when you want to test actual delivery.
# Render Free must not use SMTP; production uses Brevo HTTPS API.
EMAIL_PROVIDER=smtp
DEFAULT_FROM_EMAIL=no-reply@localhost
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=EduAI School Management
EMAIL_API_TIMEOUT=20

# Optional SMTP settings for a paid/alternative deployment where SMTP is allowed.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=True

# Optional persistent media storage for production
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
